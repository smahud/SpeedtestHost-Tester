# Arena laboratory layout -- what must and must not be committed.
#
# The official OoklaServer daemon and the official Speedtest CLI are
# proprietary binaries.  They are downloaded and hash-verified by
# lab/scripts/download-official.sh instead of being committed; the expected
# SHA-256 values are recorded in lab/binaries/MANIFEST.md and lab/cli/MANIFEST.md.
#
# Public certificates (no private key) are committed so that the laboratory
# trust store can be reproduced without a download.

# ---- downloaded official binaries (never committed) -------------------------
lab/binaries/*.tgz
lab/binaries/x86_64/
lab/binaries/aarch64/
lab/binaries/headers-*.txt
lab/cli/speedtest

# ---- laboratory runtime state (never committed) -----------------------------
lab/runtime/
lab/logs/
lab/results/*.pid

# The verbose CLI logs ARE evidence and are committed; only the daemon's
# runtime logs under lab/logs/ are not.
!lab/results/*.log
!lab/results/previous-session/*.log

# ---- private key material (never committed) ---------------------------------
lab/certs/*.key
lab/certs/*.csr
lab/certs/*.srl
lab/certs/*.pem
!lab/certs/ca.crt
!lab/certs/server.crt
!lab/certs/fullchain.pem
!lab/certs/control.crt
!lab/certs/ca-bundle-cli.pem

# ---- delivery transfer artefacts (large, redundant with the branch) ---------
lab/results/delivery/*.bundle
lab/results/delivery/*.patch

# ---- Python bytecode ---------------------------------------------------------
__pycache__/
*.py[cod]
